# Public HTTPS address of this app. Calendar apps (Google, Outlook, Apple) must be able to reach it.
PUBLIC_URL=https://grants.yourdomain.com

# Time zone for "today" and the daily scan
TZ_NAME=America/New_York

# When the daily scan runs (cron format, in TZ_NAME). Default: 6:00 every morning
SCAN_CRON=0 6 * * *

# Optional: password-protect the dashboard (calendar feed links stay usable by calendar apps)
APP_PASSWORD=

# Set to false after you've created your organization(s) so strangers can't sign up
ALLOW_SIGNUP=true

# Optional: daily email digest. Any SMTP provider works: Gmail app password, Outlook, SendGrid, Mailgun, Amazon SES
# Examples:
#   SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
#   SMTP_URL=smtp://apikey:SG.xxxxx@smtp.sendgrid.net:587
SMTP_URL=
MAIL_FROM=Grants for Me <grants@yourdomain.com>
